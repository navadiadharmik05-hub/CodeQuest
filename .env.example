# =============================================================================
# CodeQuest — Environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# PostgreSQL connection string (standard role for Prisma migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/codequest?schema=public"

# Prisma Accelerate / Supabase connection pooler URL (optional, for production)
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth — create at https://github.com/settings/applications/new
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Vercel / Railway / Supabase service-role key (bypasses RLS)
# POSTGRES_SERVICE_ROLE_KEY="..."

# Next.js public vars (safe to expose to browser)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CodeQuest"
