// Prisma schema for CodeQuest
// DB: PostgreSQL 15+  |  ORM: Prisma 5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// NextAuth models
// ---------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Game state
  totalXp          Int       @default(0)  @map("total_xp")
  level            Int       @default(1)
  hearts           Int       @default(5)
  streakCount      Int       @default(0)  @map("streak_count")
  lastActiveDate   DateTime? @map("last_active_date") @db.Date
  lastHeartLossAt  DateTime? @map("last_heart_loss_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt    @map("updated_at")

  // Relations
  questCompletions UserQuestCompletion[]
  earnedBadges     UserBadge[]
  skillNodes       UserSkillNode[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token")  @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")      @db.Text
  sessionState      String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Game catalogue (static)
// ---------------------------------------------------------------------------
model Quest {
  id           String @id
  name         String
  difficulty   String // EASY | MEDIUM | HARD | BOSS
  baseXp       Int    @map("base_xp")
  minTimeSecs  Int    @map("min_time_secs")
  displayOrder Int    @default(0) @map("display_order")

  completions UserQuestCompletion[]
  skillNodes  SkillNode[]

  @@map("quests")
}

model Badge {
  id           String @id
  icon         String
  name         String
  description  String
  displayOrder Int    @default(0) @map("display_order")

  earnedBy UserBadge[]

  @@map("badges")
}

model SkillNode {
  id            String  @id
  icon          String
  name          String
  questId       String? @map("quest_id")
  initialStatus String  @map("initial_status") // unlocked | active | locked
  displayOrder  Int     @default(0) @map("display_order")

  quest    Quest?         @relation(fields: [questId], references: [id])
  userNodes UserSkillNode[]

  @@map("skill_nodes")
}

// ---------------------------------------------------------------------------
// User runtime tables
// ---------------------------------------------------------------------------
model UserQuestCompletion {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  questId        String   @map("quest_id")
  completedAt    DateTime @default(now()) @map("completed_at")
  xpEarned       Int      @map("xp_earned")
  timeSpentSecs  Int      @map("time_spent_secs")
  isOptimal      Boolean  @default(false) @map("is_optimal")
  streakAtTime   Int      @default(0)    @map("streak_at_time")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id])

  @@map("user_quest_completions")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model UserSkillNode {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  nodeId      String    @map("node_id")
  status      String    // unlocked | active | locked
  unlockedAt  DateTime? @map("unlocked_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  node SkillNode @relation(fields: [nodeId], references: [id])

  @@unique([userId, nodeId])
  @@map("user_skill_nodes")
}
